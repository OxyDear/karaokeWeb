<a class="back-link" href="/">← Назад к каталогу</a>

<h1>Добавить песню</h1>

<% if (errors && errors.length > 0) { %>
  <div class="error-box">
    <strong>Не удалось сохранить песню:</strong>
    <ul>
      <% errors.forEach(function(e) { %><li><%= e %></li><% }); %>
    </ul>
  </div>
<% } %>

<form class="song-form" method="POST" action="/add">
  <div>
    <label for="title">Название песни</label>
    <input type="text" id="title" name="title" placeholder="Например, «Летний дождь»" required>
  </div>

  <div class="field-row">
    <div>
      <label for="artist">Исполнитель</label>
      <input type="text" id="artist" name="artist" placeholder="Название группы или имя артиста" required>
    </div>
    <div>
      <label for="genre">Жанр</label>
      <input type="text" id="genre" name="genre" placeholder="Поп, рок, баллада...">
    </div>
  </div>

  <div>
    <label for="duration">Длительность (в секундах)</label>
    <input type="number" id="duration" name="duration" placeholder="210">
  </div>

  <div>
    <label for="audioUrl">Ссылка на аудиодорожку</label>
    <input type="text" id="audioUrl" name="audioUrl" placeholder="/audio/my-track.mp3">
  </div>

  <div>
    <label for="lyrics">Текст песни</label>
    <textarea id="lyrics" name="lyrics" placeholder="Куплет 1:&#10;...&#10;&#10;Припев:&#10;..."></textarea>
  </div>

  <button type="submit" class="btn-primary">Добавить в каталог</button>
</form>
