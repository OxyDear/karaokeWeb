<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · Караоке.онлайн</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site">
    <div class="wrap">
      <div class="brand">Караоке<span>.онлайн</span></div>
      <nav class="site-nav">
        <a href="/">Каталог</a>
        <a href="/add">Добавить песню</a>
        <% if (typeof user !== 'undefined' && user) { %>
          <span class="user-pill <%= user.isAuthenticated ? 'authed' : '' %>">
            <%= user.isAuthenticated ? '● ' + user.name : '○ Гость' %>
          </span>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="wrap"></main>
