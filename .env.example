DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/karaoke_db
DB_DIALECT=postgres
PORT=3000

# Секрет для подписи JWT. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Учётная запись администратора, которую создаёт сид
ADMIN_EMAIL=admin@karaoke.local
ADMIN_PASSWORD=admin12345
